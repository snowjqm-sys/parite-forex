{
  "version": 2,
  "regions": ["hkg1"],
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "**/*.{py,html,css,json}"
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.py" }
  ],
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=120, s-maxage=300, stale-while-revalidate=86400" },
        { "key": "Vercel-CDN-Cache-Control", "value": "s-maxage=300, stale-while-revalidate=86400" },
        { "key": "CDN-Cache-Control", "value": "s-maxage=300, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/api/rates",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=600, stale-while-revalidate=3600" },
        { "key": "Vercel-CDN-Cache-Control", "value": "s-maxage=600, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/api/currencies",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=600, stale-while-revalidate=3600" },
        { "key": "Vercel-CDN-Cache-Control", "value": "s-maxage=600, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/api/snapshot",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=600, stale-while-revalidate=3600" },
        { "key": "Vercel-CDN-Cache-Control", "value": "s-maxage=600, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/api/regression",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=600, stale-while-revalidate=3600" },
        { "key": "Vercel-CDN-Cache-Control", "value": "s-maxage=600, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/api/currency/(.*)/history",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=600, stale-while-revalidate=3600" },
        { "key": "Vercel-CDN-Cache-Control", "value": "s-maxage=600, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/api/currency/(.*)/monthly",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=600, stale-while-revalidate=3600" },
        { "key": "Vercel-CDN-Cache-Control", "value": "s-maxage=600, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/api/currency/(.*)/daily",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=600, stale-while-revalidate=3600" },
        { "key": "Vercel-CDN-Cache-Control", "value": "s-maxage=600, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/api/ticker",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store, no-cache" }
      ]
    },
    {
      "source": "/api/live/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store, no-cache" }
      ]
    },
    {
      "source": "/api/feedback(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store, no-cache" }
      ]
    },
    {
      "source": "/api/ai/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store, no-cache" }
      ]
    },
    {
      "source": "/api/admin/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store, no-cache" }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store, no-cache" }
      ]
    },
    {
      "source": "/ai-config(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store, no-cache" }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, immutable" },
        { "key": "Vercel-CDN-Cache-Control", "value": "s-maxage=86400, stale-while-revalidate=604800" },
        { "key": "CDN-Cache-Control", "value": "s-maxage=86400" }
      ]
    }
  ]
}
